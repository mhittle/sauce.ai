# sauce.ai/redteam configuration. All optional; sensible defaults in app/config.py.

# --- storage / server ---
REDTEAM_DB_PATH=data/redteam.db
PUBLIC_BASE_URL=https://redteam.sauce.ai

# --- billing (free preview) ---
REDTEAM_FREE_TRIAL_LIMIT=100
REDTEAM_PRICE_PER_TRIAL_USD=0.0

# --- execution ---
REDTEAM_MAX_TURNS_CAP=20
REDTEAM_WORKER_THREADS=4
REDTEAM_TRIAL_CONCURRENCY=4
# Allow targets on private/loopback addresses (DANGEROUS; local dev only).
REDTEAM_ALLOW_PRIVATE_TARGETS=false

# --- attacker / judge provider credentials (target creds come from the researcher) ---
ANTHROPIC_API_KEY=
ANTHROPIC_REFUSAL_FALLBACK=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Any OpenAI-compatible host (Together / Groq / Fireworks / vLLM / Ollama):
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.together.xyz/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- default ensembles (provider:model, comma-separated) ---
REDTEAM_DEFAULT_ATTACKERS=anthropic:claude-sonnet-5
REDTEAM_DEFAULT_ARBITER=anthropic:claude-opus-5
REDTEAM_DEFAULT_JUDGES=anthropic:claude-opus-5

# --- email (report delivery); unset = report stays at its URL, not emailed ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=redteam@sauce.ai
SMTP_STARTTLS=true
