# sauce.ai/phenotype configuration. All optional except ANTHROPIC_API_KEY; defaults in app/config.py.

# --- storage / server ---
PHENOTYPE_DB_PATH=data/phenotype.db
PUBLIC_BASE_URL=https://phenotype.sauce.ai

# --- execution / limits ---
PHENOTYPE_WORKER_THREADS=2
PHENOTYPE_EXTRACT_CONCURRENCY=4
PHENOTYPE_MAX_RECORDS_CAP=400
PHENOTYPE_MAX_EXTRACT_CAP=40
PHENOTYPE_JOBS_PER_HOUR_PER_IP=6
PHENOTYPE_HTTP_CACHE_TTL_S=604800

# --- literature APIs (free, keyless) ---
# NCBI asks for a contact email; an API key raises the rate limit 3/s -> 10/s.
PHENOTYPE_CONTACT_EMAIL=phenotype@sauce.ai
NCBI_API_KEY=
PHENOTYPE_USE_EUROPEPMC=true

# --- models ---
ANTHROPIC_API_KEY=
ANTHROPIC_REFUSAL_FALLBACK=true
PHENOTYPE_SCREEN_MODEL=anthropic:claude-sonnet-5
PHENOTYPE_EXTRACT_MODEL=anthropic:claude-opus-5

# --- email (report delivery); unset = report stays at its URL, not emailed ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=phenotype@sauce.ai
SMTP_STARTTLS=true
