# --- Core ---
DATABASE_URL=postgres://scribe:scribe@localhost:5432/scribe
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# --- Anthropic (workers) ---
ANTHROPIC_API_KEY=
# Per-takeoff hard token cap (input+output, across all model calls for one takeoff)
TAKEOFF_TOKEN_BUDGET=2000000
# Daily crawler model-call token budget
CRAWLER_DAILY_TOKEN_BUDGET=5000000

# --- OpenAI (workers, optional) ---
# Secondary vision model for the admin "AI Cross Validation" toggle. Only used
# when that toggle is on; leave empty to disable cross-validation entirely.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1

# --- Object storage (S3-compatible: MinIO on Railway, Cloudflare R2, or S3) ---
# For MinIO on Railway: endpoint = the MinIO service's public URL,
# key/secret = MINIO_ROOT_USER/MINIO_ROOT_PASSWORD (or a service account).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scribe
# Region label (R2 uses "auto"; MinIO ignores it; AWS needs a real region)
R2_REGION=auto
# Path-style addressing is the default (required by MinIO, fine for R2).
# Set to 0 only if a provider requires virtual-hosted-style URLs.
S3_FORCE_PATH_STYLE=1
# Days before prospected docs are eligible for lifecycle deletion (set on the bucket)
R2_PROSPECT_DOC_TTL_DAYS=90

# --- Auth (Google OAuth; leave CLIENT_ID empty for local dev-bypass mode) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed to sign in before users exist in the DB.
# First listed email is created as admin.
AUTH_ALLOWED_EMAILS=mhittle@gmail.com
SESSION_SECRET=change-me-to-a-long-random-string
# Public URL of the API (for the OAuth redirect URI)
API_PUBLIC_URL=http://localhost:3001
# Public URL of the web app (for post-login redirect + CORS)
WEB_PUBLIC_URL=http://localhost:5173

# --- BigCommerce (optional, draft orders) ---
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_ACCESS_TOKEN=

# --- Web build ---
VITE_API_URL=http://localhost:3001

# --- Ops ---
SENTRY_DSN=
PORT=3001
