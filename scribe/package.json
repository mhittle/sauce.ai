{
  "name": "scribe",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval": "pnpm --filter @scribe/evals run eval",
    "dev": "turbo run dev",
    "db:migrate": "pnpm --filter @scribe/db run migrate",
    "db:seed": "pnpm --filter @scribe/db run seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
