# sauce.ai/signal — environment template. Copy to .env for local dev.

# --- Database (PostgreSQL + PostGIS + pgvector) ---
DATABASE_URL=postgresql+psycopg://signal:signal@localhost:5432/signal

# --- Ingestion ---
# Free Socrata app token lifts rate limits (https://data.cityofchicago.org → API).
SOCRATA_APP_TOKEN=
# Paid permit-API key (PRD §13.2). Leave blank to keep the paid adapter disabled.
SIGNAL_PAID_API_KEY=
INGEST_HOUR_UTC=8

# --- Semantic classification (PRD §9) ---
ANTHROPIC_API_KEY=

# --- Geo / triage defaults ---
FACILITY_LAT=33.7490
FACILITY_LNG=-84.3880
SHIPPABLE_RADIUS_MI=500

# --- Email digest (PRD §11) ---
EMAIL_API_KEY=

# --- CRM push (PRD §12) ---
CRM_WEBHOOK_URL=

# --- Web ---
SECRET_KEY=dev-insecure-change-me
CORS_ORIGINS=*
