# sauce.ai/signal — environment template. Copy to .env for local dev.

# --- Database (PostgreSQL + PostGIS + pgvector) ---
# Either set DATABASE_URL directly (URL-encode any +,/,=,@,: in the password)...
DATABASE_URL=postgresql+psycopg://signal:signal@localhost:5432/signal
# ...OR leave DATABASE_URL unset and set discrete PG* vars — we build the URL
# and encode the password for you (safest when the host generates a password
# with URL-unsafe characters):
# PGHOST=
# PGPORT=5432
# PGUSER=signal
# PGPASSWORD=
# PGDATABASE=signal

# --- Ingestion ---
# Free Socrata app token lifts rate limits (https://data.cityofchicago.org → API).
SOCRATA_APP_TOKEN=
# Paid permit-API key (PRD §13.2). Leave blank to keep the paid adapter disabled.
SIGNAL_PAID_API_KEY=
# SAM.gov Contract Opportunities API key (free from SAM.gov / data.gov) for the
# bid/plans (solicitation) track. Powers jobs/ingest_solicitations.py.
SAMGOV_API_KEY=
INGEST_HOUR_UTC=8

# --- Semantic classification (PRD §9) ---
ANTHROPIC_API_KEY=

# --- Geo / triage defaults ---
FACILITY_LAT=33.7490
FACILITY_LNG=-84.3880
SHIPPABLE_RADIUS_MI=500

# --- Email digest (PRD §11) ---
EMAIL_API_KEY=

# --- CRM push (PRD §12) ---
CRM_WEBHOOK_URL=

# --- Web ---
SECRET_KEY=dev-insecure-change-me
CORS_ORIGINS=*
