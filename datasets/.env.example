# sauce.ai/datasets configuration. Only ANTHROPIC_API_KEY is required to crawl;
# search over an existing catalog works without it.
ANTHROPIC_API_KEY=
# Where the SQLite catalog and downloaded files live (mount a volume here).
DATASETS_DATA_DIR=./data
# Model + effort for the planner (one call per crawl) and the crawl agents.
DATASETS_MODEL=claude-opus-5
DATASETS_PLANNER_EFFORT=high
DATASETS_WORKER_EFFORT=medium
# Server-side refusal fallback: "default" (Anthropic-routed) or "off".
DATASETS_FALLBACKS=default
# Crawl sizing.
DATASETS_QUERY_CRAWL_MINUTES=10
DATASETS_BROAD_CRAWL_MINUTES=60
DATASETS_SWARM_SIZE=4
DATASETS_MAX_TURNS=30
DATASETS_MAX_CONCURRENT_CRAWLS=2
DATASETS_RECRAWL_HOURS=24
# Downloads (flat files only).
DATASETS_DOWNLOAD=true
DATASETS_MAX_DOWNLOAD_MB=500
DATASETS_MAX_FILES_PER_DATASET=10
CORS_ORIGINS=*
# Literature linker (background thread in the API): papers citing / naming each dataset.
DATASETS_LITERATURE=true
# Optional but recommended: free key from https://openalex.org (adds CS/arXiv/
# conference papers and "cites" links Europe PMC doesn't have).
OPENALEX_API_KEY=
OPENALEX_MAILTO=
DATASETS_LIT_REFRESH_DAYS=30
DATASETS_LIT_INTERVAL_SEC=2
DATASETS_LIT_IDLE_SEC=300
DATASETS_LIT_MAX_MENTION_HITS=20000
